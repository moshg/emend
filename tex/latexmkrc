# 本の tex/latexmkrc から読む共通の設定:
#   do '../common/tex/latexmkrc' or die "common/ を読めない（git submodule update --init）: $@$!\n";
# latexmk は本の tex/ で動く（common/scripts/tex がそうする）．
use File::Basename;

@default_files = ('original.tex', 'revised.tex');
$pdf_mode = 4;          # lualatex
$lualatex = 'lualatex -interaction=nonstopmode -halt-on-error -file-line-error -synctex=1 %O %S';
$out_dir = 'build';

# emend.sty をこのファイルの隣の場所から読む
ensure_path('TEXINPUTS', dirname(__FILE__));

# 章ファイル（忠実版は original/，修正版は revised/）は \InputIfFileExists で読むので，新しく置いた章や
# 記号のファイルに latexmk は気づかない．そのようなファイルの一覧が前回のビルドと変わっていれば，
# すべてビルドし直す（-g と同じ）．
{
  my @files = ((map { glob("$_/*.tex"), glob("$_/*/*.tex") } 'original', 'revised'), glob('notation/*.tex'));
  my $list = join("\n", sort(@files)) . "\n";
  # 印は版（original.tex，revised.tex）ごとに置く．
  my ($root) = grep { /\.tex$/ } @ARGV;
  my $stamp = "$out_dir/input-files-" . (defined $root ? $root : "all") . ".txt";
  my $old = '';
  if (open(my $in, '<', $stamp)) { local $/; $old = <$in>; close($in); }
  if ($old ne $list) {
    $go_mode = 1;
    mkdir $out_dir;
    if (open(my $out, '>', $stamp)) { print $out $list; close($out); }
  }
}

1;  # 本の tex/latexmkrc が do … or die で読めたことを確かめる
