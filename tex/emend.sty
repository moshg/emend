% emend.sty --- 原書に忠実な版（忠実版）と，手を入れた版（修正版）を組むための仕組み
%
% 2 つの版は別のソースで，章は忠実版が tex/original/，修正版が tex/revised/ から読まれる．
% 版の切り替えはルートファイル（original.tex / revised.tex）で \def\BookMode{revised} などと
% 定義してから main.tex を読み込むことで行う．
%
% 主な機能
%   * \ifrevised                : 修正版のときに真
%   * \fixat{ID}                : 修正版で修正した箇所の目印（索引にページを載せ，リンク先を置く）
%   * \fixskip{カウンタ}{数}    : 修正で消した番号を進める
%   * \addtag，\newaddtheorem   : 修正版で足した式・定理類に直前の番号＋アルファベットの番号を振る
%   * \recordchaptercounts{名前}: 章の終わりのカウンタを aux に書く（いまは検査に使っていない．本の main.tex が呼ぶので残している）
%   * \supplied{…}，\rewritten{…} : 原書にない議論を［補完］［書き換え］の印で囲む
%   * \printfixindex            : 修正版の巻末に置く修正箇所の索引
%   * \origpage{n}              : 原書のページ境界を余白に表示
%   * \bref, \beqref            : 未 TeX 化の章を参照しても原書の番号で表示される参照
%
% 見た目（定理環境，見出し，箇条書き，\term，文献の \bcite，余白など）は本ごとの sty に書く．
% 本ごとの sty では，hyperref を（オプションを付けるならそれも）この sty より先に読む．
%
% 本ごとに変えてよいもの（この sty を読んだ後で）
%   \fixindexlead               : 索引の前置きの最初の文（\renewcommand で変える）
%   origpagecolor               : \origpage の色（\definecolor で変える）
%   fixmarkcolor                : ［補完］［書き換え］の印の色（\definecolor で変える）
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{emend}[2026/11/16 Faithful and revised editions of a book]

\RequirePackage{xcolor}
\RequirePackage{enumitem}
\RequirePackage{hyperref}

% ltjsbook: since TeX Live 2026 it adds 第 and 章 to chapter numbers when the
% table of contents is typeset, not when the entry is written, so appendix
% entries come out as 第 A 章. Switch to 付録 there too.
\@ifclassloaded{ltjsbook}{%
  \g@addto@macro\appendix{\addtocontents{toc}{%
    \protect\def\protect\@chapapp{\protect\appendixname}\protect\def\protect\@chappos{}}}}{}

\newcommand\fixindexlead{この版では原書の誤植などを修正している．}

% ---------------------------------------------------------------------------
% 版（忠実版 / 修正版）
% ---------------------------------------------------------------------------
\newif\ifrevised
\def\emend@revisedname{revised}
\ifdefined\BookMode
  \ifx\BookMode\emend@revisedname \revisedtrue \fi
\fi

\definecolor{origpagecolor}{gray}{0.55}

% \fixat{ID}
%   修正版のソース（tex/revised/）で，修正した箇所の先頭に置く目印．本文には何も出さない．
%   巻末の修正箇所の索引にそのページを載せ，索引からのリンク先を置く．
%   ID は corrections/*.md の見出しの ID と一致させる（common/scripts/check.py で検査）．
%   数式中でも使える．見出しの引数や \item[…] の中には置かない（目次やしおりに紛れ込む）．
\newcounter{emend@fixocc}
\def\emend@curfixid{}
%   \fixat が別表示の式の直後など，行の先頭（まだ何もない）にあるときは，その後の空白
%   （\fixat の後の改行）を読み飛ばす．読み飛ばさないと，式の次の行の頭に空白が入る．
\NewDocumentCommand\fixat{m}{%
  \stepcounter{emend@fixocc}%
  \ifhmode\ifnum\lastnodetype=\m@ne\let\emend@next\ignorespaces\else\let\emend@next\relax\fi
  \else\let\emend@next\relax\fi
  \emend@fixanchor{#1}%
  \gdef\emend@curfixid{#1}%
  \emend@next}
% \fixskip{カウンタ}{数}
%   修正で式や定理を消したとき，その後に置いて，消した分だけ番号を進める．
%   以降の番号を原書（忠実版）と同じに保ちたいときに使う（make check は確かめない）．
%   \stepcounter と同じく，従属するカウンタ（\addtag のアルファベットなど）は 0 に戻す．
\newcommand\fixskip[2]{\addtocounter{#1}{#2}%
  \begingroup\let\@elt\emend@zerocounter\csname cl@#1\endcsname\endgroup}
\def\emend@zerocounter#1{\global\csname c@#1\endcsname\z@\csname cl@#1\endcsname}
% \addtag，\newaddtheorem{環境}{見出し}
%   修正版で足した式・定理類に，直前の番号にアルファベットを付けた番号 (1.2a)，補題 1.2.3a を振る．
%   番号のカウンタは進めない．\addtag は equation* や align* の行で \tag の代わりに書く．
%   \newaddtheorem は本の sty で，カウンタ theorem を共有する定理環境を作った後に使う．
\newcounter{emend@addeq}\counterwithin*{emend@addeq}{equation}
\newcommand\addtag{\stepcounter{emend@addeq}%
  \protected@edef\emend@addnum{\theequation\alph{emend@addeq}}%
  \expandafter\tag\expandafter{\emend@addnum}}
\newcommand\newaddtheorem[2]{%
  \@ifundefined{c@emend@addthm}{\newcounter{emend@addthm}\counterwithin*{emend@addthm}{theorem}%
    \renewcommand\theemend@addthm{\thetheorem\alph{emend@addthm}}}{}%
  \newtheorem{#1}[emend@addthm]{#2}}
% \recordchaptercounts{名前}
%   main.tex の章の差し込み口が，章を読み込んだ後に呼ぶ．章ごとにリセットされるカウンタ（節・式・
%   定理・脚注など）の章の終わりの値を aux に書く．以前は common/scripts/check.py が忠実版と修正版で
%   比べていたが，修正版の番号を原書と一致させる規約をやめたので，いまは何も読まない．
\def\emend@counts#1#2{}
\newcommand\recordchaptercounts[1]{%
  \begingroup
    \def\@elt##1{ ##1=\the\value{##1}}%
    \immediate\write\@auxout{\string\emend@counts{#1}{\cl@chapter}}%
  \endgroup}
% \supplied{…}，\rewritten{…}
%   修正版で原書にない議論を囲む．本文で始まりと終わりに
%   ［補完］…［補完ここまで］，［書き換え］…［書き換えここまで］の印を出し，
%   巻末の索引でも直前の \fixat の ID に「（補完）」「（書き換え）」と付ける．
%   \fixat{ID} の直後か，\fixat{ID}\begin{proof} の直後に置く（common/scripts/marks.py で検査）．
%   数式の中では使わない．
\definecolor{fixmarkcolor}{gray}{0.4}
\NewDocumentCommand\supplied{+m}{\emend@marked{supplied}{補完}{#1}}
\NewDocumentCommand\rewritten{+m}{\emend@marked{rewritten}{書き換え}{#1}}
\long\def\emend@marked#1#2#3{%
  % 印の後の空きは伸びてよい（印の分だけ長くなった行が，長い数式の手前で組めなくなるのを防ぐ）
  \ifvmode\leavevmode\fi\emend@markbox{#2}\hskip\z@\@plus\zw
  \protected@write\@auxout{}{\string\emend@markedid{\emend@curfixid}{#1}}%
  #3%
  \ifvmode\noindent\fi\emend@markbox{#2ここまで}}
\def\emend@markbox#1{{\footnotesize\gtfamily\textcolor{fixmarkcolor}{［#1］}}}
\def\emend@markedid#1#2{\expandafter\gdef\csname emend@marked@#2@#1\endcsname{}}
\def\emend@fixanchor#1{%
  \ifvmode
    % 段落間では直前の空きの前に印を置き，\addvspace による空きの統合を妨げない
    \skip@\lastskip\ifdim\skip@=\z@\else\vskip-\skip@\fi
    \emend@fixmarks{#1}%
    \ifdim\skip@=\z@\else\vskip\skip@\fi
  \else
    \emend@fixmarks{#1}%
  \fi}
\def\emend@fixmarks#1{%
  \ifhmode\Hy@raisedlink{\hypertarget{fix:#1:\arabic{emend@fixocc}}{}}%
  \else\hypertarget{fix:#1:\arabic{emend@fixocc}}{}\fi
  \protected@write\@auxout{}{\string\emend@fixloc{#1}{\thepage}{\arabic{emend@fixocc}}}}
% aux から修正箇所のページを集める（aux は \begin{document} で読まれる）
\def\emend@fixids{}
\def\emend@fixloc#1#2#3{%
  \@ifundefined{emend@fixpages@#1}{%
    \expandafter\gdef\csname emend@fixpages@#1\endcsname{}%
    \g@addto@macro\emend@fixids{\emend@fixitem{#1}}}{}%
  % 同じページに同じ ID が複数あるときは最初の 1 つだけ載せる
  \expandafter\ifx\csname emend@fixlast@#1\endcsname\relax\else
    \edef\emend@tmp{\csname emend@fixlast@#1\endcsname}\def\emend@tmpb{#2}%
  \fi
  \ifx\emend@tmp\emend@tmpb\else
    \expandafter\g@addto@macro\csname emend@fixpages@#1\endcsname{\emend@fixpage{#2}{#1:#3}}%
  \fi
  \expandafter\gdef\csname emend@fixlast@#1\endcsname{#2}%
  \let\emend@tmp\relax\let\emend@tmpb\@empty}
\let\emend@tmp\relax
% 文書末尾での aux 再読み込み時には何もしない
\long\def\emend@gobblethree#1#2#3{}
\AtEndDocument{\let\emend@fixloc\emend@gobblethree\let\emend@markedid\@gobbletwo}
\def\emend@fixpage#1#2{\hyperlink{fix:#2}{p.\,#1}\space}
\def\emend@fixitem#1{\item[\texttt{#1}] \csname emend@fixpages@#1\endcsname
  \@ifundefined{emend@marked@supplied@#1}{}{（補完）}\@ifundefined{emend@marked@rewritten@#1}{}{（書き換え）}}
% 修正版の巻末に置く索引
\newcommand\printfixindex{%
  \ifrevised
    \chapter*{修正箇所の索引}
    \addcontentsline{toc}{chapter}{修正箇所の索引}
    \fixindexlead 修正箇所の ID と掲載ページを以下に示す．
    各修正の内容と理由はリポジトリの \texttt{corrections/} 以下の文書にまとめてある．
    本文で\emend@markbox{補完}から\emend@markbox{補完ここまで}までの部分は原書にない議論を補ったもの，
    \emend@markbox{書き換え}から\emend@markbox{書き換えここまで}までの部分は原書の議論を書き換えたもので，
    下の一覧ではそれぞれ「（補完）」「（書き換え）」と示す．
    \par\medskip
    \ifx\emend@fixids\@empty
      （修正箇所はない）
    \else
      \begin{description}[font=\normalfont,labelwidth=4em,leftmargin=5em]
        \emend@fixids
      \end{description}
    \fi
  \fi}

% ---------------------------------------------------------------------------
% 原書ページ境界のマーカー
% ---------------------------------------------------------------------------
\newcommand\origpage[1]{%
  \ifvmode\leavevmode\fi
  \marginpar{\raggedright\tiny\textcolor{origpagecolor}{原 p.#1}}}

% ---------------------------------------------------------------------------
% 相互参照
%   ラベルは「接頭辞:原書の番号」で付ける（thm:1.1.1，eq:1.12，fig:1.1，sec:1.1，ch:1 など）．
%   参照先がまだ TeX 化されていない場合は，ラベル名の番号部分をそのまま表示する．
%   ただし rev: ラベル（修正版で足した式・定理類）は必ずあるので普通に \ref で参照し，
%   ないときは LaTeX の警告を make check がエラーにする（名前を変えた後の古い参照に気づける）．
%   忠実版では common/scripts/check.py が「ラベル名の番号」と「実際の番号」の一致を検査する
%   （修正版は番号を変えてよいので検査しない）．
% ---------------------------------------------------------------------------
\def\emend@splitlabel#1:#2\@nil{#2}
\def\emend@labelprefix#1:#2\@nil{#1}
\def\emend@alwaysref@rev{}
\newcommand\bref[1]{%
  \@ifundefined{emend@alwaysref@\emend@labelprefix#1\@nil}%
    {\@ifundefined{r@#1}{\emend@splitlabel#1\@nil}{\ref{#1}}}{\ref{#1}}}
\newcommand\beqref[1]{\textup{(\bref{#1})}}

\endinput
