% emend.sty --- 原書に忠実な版（忠実版）と，手を入れた版（修正版）を組むための仕組み
%
% 2 つの版は別のソースで，章は忠実版が tex/original/，修正版が tex/revised/ から読まれる．
% 版の切り替えはルートファイル（original.tex / revised.tex）で \def\BookMode{revised} などと
% 定義してから main.tex を読み込むことで行う．
%
% 主な機能
%   * \ifrevised                : 修正版のときに真
%   * \fixat{ID}                : 修正版で修正した箇所の目印（PDF には何も出さない）
%   * 修正版で番号が原書と変わった定理類の余白に「原 補題 4.34」を出す（\origname，\origthmmark）
%   * \fixskip{カウンタ}{数}    : 修正で消した番号を進める（番号を原書と同じに保つ本だけが使う）
%   * \addtag，\newaddtheorem   : 修正版で足した式・定理類に直前の番号＋アルファベットの番号を振る（同上）
%   * \supplied{…}，\rewritten{…} : 原書にない議論を［補完］［書き換え］の印で囲む
%   * \origpage{n}              : 原書のページ境界を余白に表示
%   * \bref, \beqref            : 未 TeX 化の章を参照しても原書の番号で表示される参照
%
% 見た目（定理環境，見出し，箇条書き，\term，文献の \bcite，余白など）と hyperref の読み込みは本ごとの sty に書く．
%
% 本ごとに変えてよいもの（この sty を読んだ後で）
%   origpagecolor               : \origpage の色（\definecolor で変える）
%   fixmarkcolor                : ［補完］［書き換え］の印の色（\definecolor で変える）
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{emend}[2026/11/23 Faithful and revised editions of a book]

\RequirePackage{xcolor}

% ltjsbook: since TeX Live 2026 it adds 第 and 章 to chapter numbers when the
% table of contents is typeset, not when the entry is written, so appendix
% entries come out as 第 A 章. Switch to 付録 there too.
\@ifclassloaded{ltjsbook}{%
  \g@addto@macro\appendix{\addtocontents{toc}{%
    \protect\def\protect\@chapapp{\protect\appendixname}\protect\def\protect\@chappos{}}}}{}

% ---------------------------------------------------------------------------
% 版（忠実版 / 修正版）
% ---------------------------------------------------------------------------
\newif\ifrevised
\def\emend@revisedname{revised}
\ifdefined\BookMode
  \ifx\BookMode\emend@revisedname \revisedtrue \fi
\fi

\definecolor{origpagecolor}{gray}{0.55}

% \fixat{ID}
%   修正版のソース（tex/revised/）で，修正した箇所の先頭に置く目印．PDF には何も出さない．
%   ID は corrections/*.md の見出しの ID と一致させる（common/scripts/check.py で検査）．
%   数式中でも使える．見出しの引数の中には置かない（しおりに ID が紛れ込むことがある）．
%   \fixat が別行立ての式の直後など，行の先頭（まだ何もない）にあるときは，その後の空白
%   （\fixat の後の改行）を読み飛ばす．読み飛ばさないと，式の次の行の頭に空白が入る．
\NewDocumentCommand\fixat{m}{%
  \let\emend@next\relax
  \ifhmode\ifnum\lastnodetype=\m@ne\let\emend@next\ignorespaces\fi\fi
  \emend@next}
% \fixskip{カウンタ}{数}
%   修正で式や定理を消したとき，その後に置いて，消した分だけ番号を進める．
%   以降の番号を原書（忠実版）と同じに保つと決めた本だけが使う（make check は確かめない）．
%   \stepcounter と同じく，従属するカウンタ（\addtag のアルファベットなど）は 0 に戻す．
\newcommand\fixskip[2]{\addtocounter{#1}{#2}%
  \begingroup\let\@elt\emend@zerocounter\csname cl@#1\endcsname\endgroup}
\def\emend@zerocounter#1{\global\csname c@#1\endcsname\z@\csname cl@#1\endcsname}
% \addtag，\newaddtheorem[カウンタ]{環境}{見出し}
%   番号を原書と同じに保つ本で，修正版で足した式・定理類に，直前の番号にアルファベットを付けた
%   番号 (1.2a)，補題 1.2.3a を振る．番号のカウンタは進めない．
%   \addtag は equation* や align* の行で \tag の代わりに書く．
%   \newaddtheorem は本の sty で，定理類の番号のカウンタ（省略すると theorem．定理類が
%   \newtheorem{definition}{定義}[chapter] のカウンタを共有する本なら definition）を
%   共有する定理環境を作った後に使う．カウンタは最初に呼んだときのものに決まる．
\newcounter{emend@addeq}\counterwithin*{emend@addeq}{equation}
\newcommand\addtag{\stepcounter{emend@addeq}%
  \protected@edef\emend@addnum{\theequation\alph{emend@addeq}}%
  \expandafter\tag\expandafter{\emend@addnum}}
\newcommand\newaddtheorem[3][theorem]{%
  \@ifundefined{c@emend@addthm}{\newcounter{emend@addthm}\counterwithin*{emend@addthm}{#1}%
    \expandafter\def\expandafter\theemend@addthm\expandafter{%
      \csname the#1\endcsname\alph{emend@addthm}}}{}%
  \newtheorem{#2}[emend@addthm]{#3}}
% \supplied{…}，\rewritten{…}
%   修正版で原書にない議論を囲む．本文で始まりと終わりに
%   ［補完］…［補完ここまで］，［書き換え］…［書き換えここまで］の印を出す．
%   \fixat{ID} の直後か，\fixat{ID}\begin{proof} の直後に置く（common/scripts/marks.py で検査）．
%   数式の中では使わない．
\definecolor{fixmarkcolor}{gray}{0.4}
\NewDocumentCommand\supplied{+m}{\emend@marked{補完}{#1}}
\NewDocumentCommand\rewritten{+m}{\emend@marked{書き換え}{#1}}
\long\def\emend@marked#1#2{%
  % 印の後の空きは伸びてよい（印の分だけ長くなった行が，長い数式の手前で組めなくなるのを防ぐ）
  \ifvmode\leavevmode\fi\emend@markbox{#1}\hskip\z@\@plus\zw
  #2%
  \ifvmode\noindent\fi\emend@markbox{#1ここまで}}
\def\emend@markbox#1{{\footnotesize\gtfamily\textcolor{fixmarkcolor}{［#1］}}}

% ---------------------------------------------------------------------------
% 原書ページ境界のマーカー
% ---------------------------------------------------------------------------
\newcommand\origpage[1]{%
  \ifvmode\leavevmode\fi
  \marginpar{\raggedright\tiny\textcolor{origpagecolor}{原 p.#1}}}

% ---------------------------------------------------------------------------
% 修正版で番号が原書と変わった定理類
%   修正版では，定理類を消したり移したり足したりすると，後の番号が原書とずれる．ラベルは
%   「thm:原書の番号」のまま残すので，修正版の \label{thm:…} の時点で，ラベル名の番号と実際の
%   番号（\@currentlabel）を比べ，違えば見出しの余白に「原 補題 4.34」と原書の番号を出す．
%   種類の名前（「補題」）は amsthm の定理環境の見出しの名前をとる（amsthm を使わない本では
%   番号だけを出す）．種類を変えた（補題を系にしたなど）ときは，\label の前に \origname{補題} と
%   原書の種類を書く．式（eq:）には出さない．
%   \origthmmark{種類}{番号} が余白に出す命令で，本の sty で \renewcommand して見た目を変えたり，
%   \renewcommand\origthmmark[2]{} で出さないようにしたりできる．
% ---------------------------------------------------------------------------
\newcommand\origthmmark[2]{%
  \ifvmode\leavevmode\fi
  \marginpar{\raggedright\tiny\textcolor{origpagecolor}{原 \if\relax\detokenize{#1}\relax\else#1 \fi#2}}}
\def\emend@thmname{}
\newcommand\origname[1]{\gdef\emend@thmname{#1}}
\def\emend@origmark#1{%
  \edef\emend@prefix{\emend@labelprefix#1:\@nil}%
  \def\emend@thmprefix{thm}%
  \ifx\emend@prefix\emend@thmprefix
    \edef\emend@orignum{\emend@splitlabel#1\@nil}%
    \protected@edef\emend@curnum{\@currentlabel}%
    \ifx\emend@orignum\emend@curnum\else
      \edef\emend@tmp{\noexpand\origthmmark{\unexpanded\expandafter{\emend@thmname}}{\emend@orignum}}%
      \emend@tmp
    \fi
  \fi}
\ifrevised
  \AtBeginDocument{%
    % amsthm の定理環境は \@thm{…}{環境}{見出しの名前} で始まる．その名前を覚えておく
    \@ifundefined{thmhead@plain}{}{%
      \let\emend@thm@orig\@thm
      \def\@thm#1#2#3{\gdef\emend@thmname{#3}\emend@thm@orig{#1}{#2}{#3}}}%
    % hyperref などが \label を定め直した後で包む（別行立ての式の中では amsmath が別の \label を使う）
    \let\emend@label@orig\label
    \def\label#1{\emend@label@orig{#1}\emend@origmark{#1}}}
\fi

% ---------------------------------------------------------------------------
% 相互参照
%   ラベルは「接頭辞:原書の番号」で付ける（thm:1.1.1，eq:1.12，fig:1.1，sec:1.1，ch:1 など）．
%   参照先がまだ TeX 化されていない場合は，ラベル名の番号部分をそのまま表示する．
%   ただし rev: ラベル（修正版で足した式・定理類）は必ずあるので普通に \ref で参照し，
%   ないときは LaTeX の警告を make check がエラーにする（名前を変えた後の古い参照に気づける）．
%   忠実版では common/scripts/check.py が「ラベル名の番号」と「実際の番号」の一致を検査する
%   （修正版は番号を変えてよいので検査しない）．
% ---------------------------------------------------------------------------
\def\emend@splitlabel#1:#2\@nil{#2}
\def\emend@labelprefix#1:#2\@nil{#1}
\def\emend@alwaysref@rev{}
\newcommand\bref[1]{%
  \@ifundefined{emend@alwaysref@\emend@labelprefix#1\@nil}%
    {\@ifundefined{r@#1}{\emend@splitlabel#1\@nil}{\ref{#1}}}{\ref{#1}}}
\newcommand\beqref[1]{\textup{(\bref{#1})}}

\endinput
